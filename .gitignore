# ==============================================================
# EVChargeHub - Root .gitignore
# ==============================================================

# Environment and secrets (CRITICAL: Never commit to Git)
.env
.env*.local
*.env

# Build outputs
target/
dist/
build/

# Dependency directories
node_modules/

# Docker persistent volume local directory
postgres_data/

# IDE and editor settings
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db

# Temporary scratch and development test scripts
frontend/scratch/

# Legacy standalone mock auth server (superseded by Spring Boot backend)
frontend/server/

# Accidental root package files (Frontend contains its own package.json)
/package.json
/package-lock.json
