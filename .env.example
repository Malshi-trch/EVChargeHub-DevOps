# ==============================================================
# EVChargeHub - Docker Environment Configuration
# ==============================================================
# Copy this template to a file named ".env" in this directory:
#   cp .env.example .env
# Fill in your actual secrets below.
#
# IMPORTANT:
# - NEVER commit your actual ".env" file to version control.
# - The host port 5433 is intentionally mapped for Docker PostgreSQL
#   to prevent port collisions with an existing Windows PostgreSQL on 5432.
# ==============================================================

# ---------- PostgreSQL Database Settings ----------
# Database name inside PostgreSQL
DB_NAME=evchargehub

# Database master username
DB_USERNAME=postgres

# Database master password (REQUIRED: Change this to your secure password)
DB_PASSWORD=your_secure_db_password_here

# PostgreSQL Host Port mapping (Host:Container -> 5433:5432)
POSTGRES_PORT=5433

# ---------- JWT (JSON Web Token) Security ----------
# Secret key used to sign JWT tokens.
# Must be at least 256 bits (32+ characters).
# Example generator: openssl rand -base64 64
JWT_SECRET=your_secure_jwt_secret_key_must_be_at_least_32_characters_long

# Token expiration duration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ---------- Service Port Bindings ----------
# Port exposed to host machine for Spring Boot Backend
BACKEND_PORT=8080

# Port exposed to host machine for React + Vite + Nginx Frontend
FRONTEND_PORT=5173
